{
  "name": "tagwerk",
  "productName": "Tagwerk",
  "version": "0.1.0",
  "private": true,
  "description": "Schnelle Erfassung aller Aufgaben, die im Arbeitsalltag reinkommen - pro Tag und pro Woche.",
  "main": "src/main/main.js",
  "author": "Julraider",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev --devtools",
    "test": "node --test \"test/*.test.js\"",
    "icons": "node scripts/make-icons.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "de.julraider.tagwerk",
    "productName": "Tagwerk",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "category": "Office"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.productivity"
    }
  }
}
